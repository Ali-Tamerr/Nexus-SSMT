{
  "name": "nexus",
  "version": "0.1.0",
  "description": "An interactive Social Study Mapping Tool.",
  "author": "Ali Tamer",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run deploy:worker",
    "lint": "eslint",
    "build:worker": "npx @opennextjs/cloudflare build",
    "deploy:worker": "npm run build:worker && npx wrangler pages deploy .open-next",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@react-oauth/google": "^0.13.5",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "wrangler": "^4.127.1"
  }
}
